# =============================================================================
# SearchBoost — Environment Configuration Template
# Copy this file to .env before starting services:
#   cp .env.example .env
# =============================================================================

# ── Application & Auth Secrets ───────────────────────────────────────────────
# IMPORTANT: Generate a strong, random 256-bit secret for production (e.g., openssl rand -base64 32)
JWT_SECRET=super_secret_jwt_key_change_me_in_production_12345
NODE_ENV=production

# ── PostgreSQL Database ──────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_USER=searchboost
DB_PASSWORD=searchboost_pass
DB_NAME=searchboost_db

# ── Redis Cache & Task Queue ─────────────────────────────────────────────────
SEARCHBOOST_REDIS_HOST=sb_redis
SEARCHBOOST_REDIS_PORT=6379
REDIS_PORT=6379
REDIS_PASSWORD=searchboost_pass

# ── AI Model & Ollama Engine ─────────────────────────────────────────────────
SEARCHBOOST_TYPE=local
SEARCHBOOST_AI_MODEL=llama3.2
SEARCHBOOST_AI_HOST=sb_ollama
OLLAMA_PORT=11434

# ── SearXNG Metasearch Engine ────────────────────────────────────────────────
SEARCHBOOST_SEARCH_HOST=sb-searxng
SEARXNG_PORT=8080

# ── Rust Warden Security Sidecar ─────────────────────────────────────────────
WARDEN_PORT=14141
WARDEN_URL=http://warden:14141
RUST_LOG=info
