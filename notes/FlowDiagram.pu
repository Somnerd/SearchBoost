@startuml
actor User
participant "React UI" as UI
participant "Node.js API" as API
database "PostgreSQL" as DB
participant "Rust Warden" as WRD
database "Redis" as RD
participant "Python Worker" as WKR
participant "Ollama / LLM" as LLM
participant "SearXNG" as SRX

User -> UI : Enter Query
UI -> API : POST /api/search/enqueue {query, thread_id}
API -> WRD : POST /enqueue {query, thread_id, username}
WRD -> DB : Verify Ownership (IDOR Check)
WRD -> RD : Check Semantic Cache
alt Cache Hit
    RD --> WRD : Return Answer
    WRD --> API : (Instant) Return Answer
    API -> DB : Save History
    API --> UI : OK (Status: Complete)
else Cache Miss
    WRD -> RD : Enqueue Job (ZADD arq:queue)
    WRD --> API : OK (Status: Queued, job_id)
    API --> UI : OK (Start Polling)
    
    WKR -> RD : Pull Job
    WKR -> LLM : Optimize Query
    WKR -> RD : Check Post-Opt Cache
    alt Post-Opt Cache Hit
        RD --> WKR : Return Answer
    else Post-Opt Miss
        WKR -> SRX : Perform Web Search
        SRX --> WKR : Results
        WKR -> LLM : Final Synthesis
    end
    WKR -> DB : Save Assistant Turn
    WKR -> RD : Cache Result (if PII-Safe)
    WKR -> RD : SET sb:result:job_id
    
    UI -> API : GET /api/search/result/:id
    API -> WRD : GET /results/:id?username=...
    WRD -> RD : GET sb:result:id
    RD --> WRD : Result Content
    WRD --> API : Protected Result
    API --> UI : final_answer
end
@enduml